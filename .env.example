# Datenbank
# SQLite braucht keinen eigenen Dienst. Für den Wechsel auf PostgreSQL siehe README.
DATABASE_URL="file:./dev.db"

# Anwendung
APP_NAME="Komon"
APP_URL="http://localhost:3000"
SESSION_MAX_AGE_DAYS=30

# Dateiablage
# Relativ zum Projektverzeichnis oder ein absoluter Pfad.
STORAGE_DIR="storage"
MAX_UPLOAD_BYTES=26214400

# E-Mail-Versand
# "log" schreibt Nachrichten nach storage/outbox statt sie zu senden.
# "smtp" versendet über den unten angegebenen Server.
MAIL_TRANSPORT="log"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASS=""
MAIL_FROM_NAME="Komon"
MAIL_FROM_EMAIL="komon@localhost"
MAIL_BATCH_SIZE=25
MAIL_MAX_ATTEMPTS=3
MAIL_WORKER_INTERVAL_MS=15000

# Gemeinsames Geheimnis für den Posteingang der Mailinglisten
# und für den Cron-Aufruf der Versand-Warteschlange.
# Bitte für den Betrieb durch einen langen Zufallswert ersetzen.
INBOUND_SECRET="komon-inbound-dev-secret"
