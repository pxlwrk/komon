# Datenbank
# Lokal genügt "docker compose up -d", das startet Postgres mit diesen Zugangsdaten.
DATABASE_URL="postgresql://komon:komon@localhost:5432/komon?schema=public"
# Eigene Datenbank für die Integrationstests.
TEST_DATABASE_URL="postgresql://komon:komon@localhost:5432/komon_test?schema=public"

# Anwendung
APP_NAME="Komon"
APP_URL="http://localhost:3000"
SESSION_MAX_AGE_DAYS=30

# Dateiablage
# Ohne BLOB_READ_WRITE_TOKEN wird auf dem lokalen Dateisystem abgelegt.
# Auf Vercel setzt ein verbundener Blob-Speicher den Token automatisch.
STORAGE_DIR="storage"
MAX_UPLOAD_BYTES=26214400
# BLOB_READ_WRITE_TOKEN=""

# E-Mail-Versand
# "log" hält Nachrichten nur in der Datenbank fest, statt sie zu senden.
# "smtp" versendet über den unten angegebenen Server.
MAIL_TRANSPORT="log"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASS=""
MAIL_FROM_NAME="Komon"
MAIL_FROM_EMAIL="komon@localhost"
MAIL_BATCH_SIZE=25
MAIL_MAX_ATTEMPTS=3
MAIL_WORKER_INTERVAL_MS=15000

# Gemeinsames Geheimnis für den Posteingang der Mailinglisten
# und für den Cron-Aufruf der Versand-Warteschlange.
# Bitte für den Betrieb durch einen langen Zufallswert ersetzen.
INBOUND_SECRET="komon-inbound-dev-secret"

# Passwort der Beispieldaten. Ohne Angabe gilt "komon-demo-2026".
# SEED_PASSWORD=""
